{
  "appId": "com.movteg.app",
  "appName": "Movteg",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://movteg.vercel.app",
    "cleartext": true,
    "allowNavigation": [
      "movteg.vercel.app",
      "*.vercel.app",
      "*.youtube.com",
      "*.googlevideo.com",
      "*.ytimg.com",
      "*.googleapis.com",
      "*"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
