{
  "appId": "com.movteg.app",
  "appName": "Movteg",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.youtube.com",
      "*.googlevideo.com",
      "*.ytimg.com",
      "*.googleapis.com",
      "*"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
